rules_version = '2';
// הביטוי הזה זהה ל-BAD_RX ב-index.html: מילים פוגעניות, קישורים ומספרי טלפון
// כללי אבטחה לטבלת השיאים של תל אביב גסר.
// מעתיקים את כל הקובץ ל-Firebase Console > Firestore Database > Rules ולוחצים Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isClean(t) {
      return !t.lower().matches('.*((^|[^א-ת])[והבלשכ]{0,2}(זונה|זונות|בן\\s*זונה|בת\\s*זונה|שרמוטה|שרמוטות|שרמוט|שרמוטים|כוס\\s*אמא|כוס\\s*אמק|כוס\\s*אמאשך|כוס\\s*אמך|כוסעמק|כוס\\s*עמק|כוסית|כוסיות|מזדיין|מזדיינת|מזדיינים|לזיין|זיון|זיונים|זין\\s*שלי|על\\s*הזין|מניאק|מניאקית|מניאקים|חרא|חארות|יא\\s*חרא|בן\\s*כלב|בת\\s*כלב|קוקסינל|קוקסינלים|ערבוש|ערבושים|כושי|כושים|כושית|מפגר|מפגרת|מפגרים|פרענק|פרענקים|ערס\\s*מסריח|דוס\\s*מסריח|תמות|שתמות|תמותו|שתמותו|אני\\s*ארצח|ארצח\\s*אותך|נרצח\\s*אותך)($|[^א-ת])|(^|[^א-ת])[והבלשכ]{0,2}(מוות\\s*ל)|\\b(fuck|shit|cunt|bitch|whore|slut|nigg|fagg|retard|asshole|motherf|rapist)[a-z]*\\b|\\b(fag|fags|dick|dicks|pussy|cock|cocks|rape|raped|kys|kill\\s*yourself)\\b|https?:|www\\.|\\.(com|net|org|il|io|ly|me|gg)\\b|[0-9][0-9 .\\-]{5,}[0-9]|t\\.me/|@[a-z0-9_]{4,}).*');
    }

    match /scores/{scoreId} {
      // כולם יכולים לקרוא את הטבלה
      allow read: if true;

      // אפשר רק להוסיף תוצאה חדשה, ורק בפורמט תקין
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'mode', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'score', 'mode', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && isClean(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 25000
        && request.resource.data.mode in ['still', 'move']
        && request.resource.data.createdAt == request.time;

      // אי אפשר לשנות או למחוק תוצאות מהאתר
      allow update, delete: if false;
    }

    // איסטר אגס: מסרים שהשאירו שחקנים שניחשו עד 100 מטר
    match /eggs/{eggId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'pano', 'lat', 'lng', 'dist', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'pano', 'lat', 'lng', 'dist', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 80
        && isClean(request.resource.data.name)
        && isClean(request.resource.data.message)
        && request.resource.data.pano is string
        && request.resource.data.pano.size() >= 10
        && request.resource.data.pano.size() <= 200
        && request.resource.data.lat is number
        && request.resource.data.lat >= 32.0 && request.resource.data.lat <= 32.2
        && request.resource.data.lng is number
        && request.resource.data.lng >= 34.7 && request.resource.data.lng <= 34.9
        && request.resource.data.dist is int
        && request.resource.data.dist >= 0
        && request.resource.data.dist <= 100
        && request.resource.data.createdAt == request.time;

      // דיווח: אפשר רק להעלות את מונה הדיווחים ב-1
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
        && request.resource.data.reports is int
        && request.resource.data.reports == resource.data.get('reports', 0) + 1;
      allow delete: if false;
    }

    // כל שאר המסד סגור
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
