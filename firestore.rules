rules_version = '2';
// כללי אבטחה לטבלת השיאים של תל אביב גסר.
// מעתיקים את כל הקובץ ל-Firebase Console > Firestore Database > Rules ולוחצים Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      // כולם יכולים לקרוא את הטבלה
      allow read: if true;

      // אפשר רק להוסיף תוצאה חדשה, ורק בפורמט תקין
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'mode', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'score', 'mode', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 25000
        && request.resource.data.mode in ['still', 'move']
        && request.resource.data.createdAt == request.time;

      // אי אפשר לשנות או למחוק תוצאות מהאתר
      allow update, delete: if false;
    }

    // איסטר אגס: מסרים שהשאירו שחקנים שניחשו עד 100 מטר
    match /eggs/{eggId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'pano', 'lat', 'lng', 'dist', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'pano', 'lat', 'lng', 'dist', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 80
        && request.resource.data.pano is string
        && request.resource.data.pano.size() >= 10
        && request.resource.data.pano.size() <= 200
        && request.resource.data.lat is number
        && request.resource.data.lat >= 32.0 && request.resource.data.lat <= 32.2
        && request.resource.data.lng is number
        && request.resource.data.lng >= 34.7 && request.resource.data.lng <= 34.9
        && request.resource.data.dist is int
        && request.resource.data.dist >= 0
        && request.resource.data.dist <= 100
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // כל שאר המסד סגור
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
